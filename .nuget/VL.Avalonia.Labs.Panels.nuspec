<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/10/nuspec.xsd">
  <metadata>
    <id>VL.Avalonia.Labs.Panels</id>
    <title>VL.Avalonia.Labs.Panels</title>
    <version>0.0.0</version>
    <authors>antokhio, bj-rn, lecloneur, azeno, woei</authors>
    <owners>bj-rn</owners>
    <projectUrl>https://github.com/bj-rn/VL.Avalonia</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>Avalonia.Labs panels (FlexPanel) for VL.Avalonia</summary>
    <description>VL.Avalonia.Labs.Panels wraps the experimental Avalonia.Labs.Panels library for VL.Avalonia, providing FlexPanel (CSS FlexBox layout) and its Flex attached properties.</description>
    <tags>vl, vvvv, gamma, avalonia, skia, flex, flexbox, panel</tags>
    <readme>README.md</readme>
      <license type="file">LICENSE</license>
      <icon>icon\icon.png</icon>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="VL.Avalonia" version="$version$" />
        <dependency id="Avalonia.Labs.Panels" version="11.2.0" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\VL.Avalonia.Labs.Panels\lib\net8.0\VL.Avalonia.Labs.Panels*" target="lib\net8.0\" exclude="" />
    <file src="..\VL.Avalonia.Labs.Panels\help\**" target="help\" exclude="" />
    <file src="..\VL.Avalonia.Labs.Panels\*.vl" target="" exclude="" />
    <file src="..\README.md" />
    <file src="..\LICENSE" />
    <file src="..\icon.png" target="icon\" />
  </files>
</package>
