          <Pad Id="QFowQi7PHNVLZTIS21gN5b" Bounds="123,640,351,242" ShowValueBox="true" isIOBox="true" Value="On current state you have to consider following:&#xD;&#xA;Spread here means, new reference on every change &gt;&#xD;&#xA;&#xD;&#xA;So:&#xD;&#xA;- mutating records in spread would reset TreeView &#xD;&#xA;- changing spread would reset tree view&#xD;&#xA;&#xD;&#xA;e.g. Children - MutableList, Items are Classes with bindable channels&#xD;&#xA;&#xD;&#xA;To make it beer in `vvvv` terms - `reconciliation` on Items added so it checks items in spread ">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
